# Used by `npm test` instead of .env. Must point at a local, throwaway database.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:test@localhost:55432/hallmate_test
JWT_SECRET=test-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=test-refresh-secret-0123456789abcdef
SUPER_ADMIN_EMAIL=admin@example.test
SUPER_ADMIN_PASSWORD=Admin@12345
BCRYPT_ROUNDS=4
# Empty: emails are logged, never sent
RESEND_API_KEY=
# Real Cloudinary keys only if you want the 5 profile-picture tests to pass
CLOUDINARY_CLOUD_NAME=dummy
CLOUDINARY_API_KEY=dummy
CLOUDINARY_API_SECRET=dummy
CLOUDINARY_URL=
