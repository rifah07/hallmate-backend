  "description": "> A modern REST API for university women's hall management in Bangladesh",
  "main": "index.js",
  "scripts": {
    "dev": "NODE_ENV=development node --watch-path=src -r ts-node/register -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
