# Server Configuration
NODE_ENV=
PORT=

# Database (Neon PostgreSQL)"
DATABASE_URL=

# JWT Secrets (Generate strong random strings)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Bcrypt
BCRYPT_ROUNDS=

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (Resend)
RESEND_API_KEY=
FROM_EMAIL=

# Browser origins allowed to call the API directly (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# 32+ chars, SAME value in the web app. Lets its /api proxy pass the reader's IP
# for rate limiting:  openssl rand -hex 32
INTERNAL_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Super Admin Bootstrap
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Online payments with SSLCommerz (bKash, Nagad, Rocket, cards). Free sandbox:
# https://developer.sslcommerz.com/registration/  · LIVE=true only with a real merchant account
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
# Where the gateway returns the payer and posts its IPN (this API), and the web app
API_PUBLIC_URL=http://localhost:5000
WEB_APP_URL=http://localhost:3000
