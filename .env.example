# ── Required ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Neon: pooled URL (host contains "-pooler") for the app...
DATABASE_URL=
# ...and the direct URL (same without "-pooler") for prisma migrate / studio
DIRECT_URL=
# Two DIFFERENT random values, 32+ characters each:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend: free, no card) ────────────────────────────────────────
# Without a verified domain, leave EMAIL_FROM empty (onboarding@resend.dev):
# Resend then delivers only to your own Resend account address.
# Empty key: emails are printed to the console (fine for development).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=HallMate
# Development only: send every email to this inbox instead
DEV_EMAIL_TO=

# ── URLs ─────────────────────────────────────────────────────────────────
# This API's public URL (payment gateway callbacks, API docs)
API_PUBLIC_URL=http://localhost:5000
# The web app (payment result page)
WEB_APP_URL=http://localhost:3000
# Browser origins allowed to call the API directly (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
# 32+ chars, SAME value in the web app: lets its /api proxy pass the reader's IP
INTERNAL_API_KEY=

# ── Online payments (optional) ───────────────────────────────────────────
# SSLCommerz sandbox (free): https://developer.sslcommerz.com/registration/
# Empty: the pay button says "pay at the hall office". LIVE=true needs a real merchant account.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false

# ── Optional, with defaults ──────────────────────────────────────────────
PORT=5000
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Seeding only (your machine, never on Vercel) ────────────────────────
# Used once by `npm run db:seed` to create the first super admin. 12+ chars.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
